export function normalizeText(input = "") {
  return String(input)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[-_]/g, " ")
    .toLowerCase()
    .trim();
}

const SYNONYMS: Record<string, string> = {
  // Plomería
  plomero: "plomeria",
  plomeros: "plomeria",
  plomeria: "plomeria",
  plomería: "plomeria",
  // Electricidad / Electricista
  electricidad: "electricidad",
  electricista: "electricidad",
  electricistas: "electricidad",
  // Aire acondicionado
  "aire acondicionado": "aire acondicionado",
  "aire-acondicionado": "aire acondicionado",
  "aire acondicionado técnico": "aire acondicionado",
  "aire acondicionado tecnico": "aire acondicionado",
  "técnico aire": "aire acondicionado",
  "tecnico aire": "aire acondicionado",
  // Carpintería
  carpinteria: "carpinteria",
  carpintero: "carpinteria",
  carpinteros: "carpinteria",
  carpintería: "carpinteria",
  // Mantenimiento General
  mantenimiento: "mantenimiento general",
  "mantenimiento general": "mantenimiento general",
  albañil: "mantenimiento general",
  pintor: "mantenimiento general",
  // Cerrajería
  cerrajero: "cerrajeria",
  cerrajeria: "cerrajeria",
  cerrajería: "cerrajeria",
  // Paneles solares
  paneles: "paneles solares",
  "paneles solares": "paneles solares",
  solar: "paneles solares",
  // Seguridad
  seguridad: "seguridad",
  // Impermeabilización
  impermeabilizacion: "impermeabilizacion",
  impermeabilización: "impermeabilizacion",
  impermeabilizador: "impermeabilizacion",
};

const NORMALIZED_SYNONYMS: Record<string, string> = Object.fromEntries(
  Object.entries(SYNONYMS).map(([key, value]) => [normalizeText(key), value])
);

export function mapQueryToCanonical(q: string) {
  const n = normalizeText(q);
  return NORMALIZED_SYNONYMS[n] ?? n;
}

export function matchesField(field = "", query = "") {
  const nf = normalizeText(field);
  const nq = normalizeText(query);
  const canonical = normalizeText(mapQueryToCanonical(query));
  const mqCandidates = Array.from(new Set([nq, canonical]));
  return mqCandidates.some((mq) => nf.includes(mq) || mq.includes(nf));
}
